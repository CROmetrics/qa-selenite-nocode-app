   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "The van leaves the Pine Street depot at 5:40, before the fog has cleared the river road.\n",
        "textStyle": {}
       }
      }
     ],
     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
