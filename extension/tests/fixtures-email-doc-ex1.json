     }
    }
   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "Odile\u2019s eleventh winter on Route 9 has taught her which bridge floods, which gate sticks and which porch light means somebody is waiting up.\n",
        "textStyle": {}
       }
      }
     ],
     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
    }
   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "\n",
        "textStyle": {}
       }
      }
