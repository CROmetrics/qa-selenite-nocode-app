   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "Packing closes on Friday at noon. Every kit ordered before then leaves the warehouse on Monday \u2014 early enough to beat the first rains.\n",
        "textStyle": {}
       }
      }
     ],
     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
