       "textRun": {
        "content": "\n",
        "textStyle": {}
       }
      }
     ],
     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
    }
   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "Two more valleys are on the waiting list, and each one needs a van, a driver and a cold box.\n",
        "textStyle": {}
       }
      }
