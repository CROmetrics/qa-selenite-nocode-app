     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
    }
   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "This season the back of the van carries insulated boxes that keep medicine cold for ten hours. \n",
        "textStyle": {}
       }
      }
     ],
     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
    }
   },
