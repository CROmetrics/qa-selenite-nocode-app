     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
    }
   },
   {
    "paragraph": {
     "elements": [
      {
       "textRun": {
        "content": "Since March, Odile\u2019s van has reached 62 clinics and pharmacies before nine in the morning.\n",
        "textStyle": {}
       }
      }
     ],
     "paragraphStyle": {
      "namedStyleType": "NORMAL_TEXT"
     }
    }
   },
   {
    "paragraph": {
